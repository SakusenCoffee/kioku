+// Kioku: answers the calls the Android UI thread makes to this (the Qt main)
+// thread while holding the deadlock protector: keyboard queries
+// (QAndroidInputContext's runOnQtThread()) and accessibility queries
+// (QtAndroidAccessibility's runInObjectContext()), which accessibility
+// services such as password managers make without TalkBack.
+static void answerUiThread()
+{
+    if (QAndroidInputContext *ic = QAndroidInputContext::androidInputContext())
+        QCoreApplication::sendPostedEvents(ic, QEvent::MetaCall);
+    QtAndroidAccessibility::answerPendingCalls();
+}
+
+// Kioku: for KiokuBridge (android/src/kioku_android.cpp), which waits for the
+// UI thread too. Qt main thread only.
+extern "C" Q_DECL_EXPORT void kioku_answer_ui_thread()
+{
+    answerUiThread();
+}
