#!/usr/bin/with-contenv bash
# ANKI_MS_FONTS=true (s6-rc's init-anki-fonts, before the desktop starts):
# Microsoft's core fonts for the web (Arial, Arial Black, Comic Sans MS,
# Courier New, Georgia, Impact, Times New Roman, Trebuchet MS, Verdana,
# Webdings, Andale Mono), which many shared decks name in their styling.
# Their licence lets them be passed on only as Microsoft's own installers,
# so the image has none: they are downloaded once from the corefonts
# project on SourceForge, checked against Debian's ttf-mscorefonts-installer
# sums, and unpacked into ~/.local/share/fonts, where fontconfig (and so
# Anki) finds them. A failed download is tried again at the next start.
[ "${ANKI_MS_FONTS,,}" = true ] || exit 0
[ "$(id -u)" = 0 ] && exec s6-setuidgid abc "$0"

fonts=$HOME/.local/share/fonts/msttcorefonts
[ -f "$fonts/licen.txt" ] && exit 0

declare -A sums=(
    [andale32.exe]=0524fe42951adc3a7eb870e32f0920313c71f170c859b5f770d82b4ee111e970
    [arial32.exe]=85297a4d146e9c87ac6f74822734bdee5f4b2a722d7eaa584b7f2cbf76f478f6
    [arialb32.exe]=a425f0ffb6a1a5ede5b979ed6177f4f4f4fdef6ae7c302a7b7720ef332fec0a8
    [comic32.exe]=9c6df3feefde26d4e41d4a4fe5db2a89f9123a772594d7f59afd062625cd204e
    [courie32.exe]=bb511d861655dde879ae552eb86b134d6fae67cb58502e6ff73ec5d9151f3384
    [georgi32.exe]=2c2c7dcda6606ea5cf08918fb7cd3f3359e9e84338dc690013f20cd42e930301
    [impact32.exe]=6061ef3b7401d9642f5dfdb5f2b376aa14663f6275e60a51207ad4facf2fccfb
    [times32.exe]=db56595ec6ef5d3de5c24994f001f03b2a13e37cee27bc25c58f6f43e8f807ab
    [trebuc32.exe]=5a690d9bb8510be1b8b4fe49f1f2319651fe51bbe54775ddddd8ef0bd07fdac9
    [verdan32.exe]=c1cb61255e363166794e47664e2f21af8e3a26cb6346eb8d2ae2fa85dd5aad96
    [webdin32.exe]=64595b5abc1080fba8610c5c34fab5863408e806aafe84653ca8575bed17d75a
)
# SourceForge picks a mirror for each download
root=https://downloads.sourceforge.net/corefonts/

tmp=$(mktemp -d) || exit 0
trap 'rm -rf "$tmp"' EXIT
cd "$tmp" || exit 0

echo "[anki-ms-fonts] downloading Microsoft's core fonts"
# all at once (a mirror can take a minute for each file), then again for
# the ones that failed
for _ in 1 2 3; do
    args=()
    for exe in "${!sums[@]}"; do
        [ -f "$exe" ] || args+=(-o "$exe" "$root$exe")
    done
    [ ${#args[@]} = 0 ] && break
    curl -fsSL --parallel --retry 2 --connect-timeout 15 --max-time 600 "${args[@]}"
    for exe in "${!sums[@]}"; do
        echo "${sums[$exe]}  $exe" | sha256sum -c --status 2>/dev/null || rm -f "$exe"
    done
done
for exe in "${!sums[@]}"; do
    [ -f "$exe" ] || { echo "[anki-ms-fonts] couldn't download $exe; trying again at the next start"; exit 0; }
done

mkdir -p out && cabextract -q -L -d out ./*.exe || exit 0
mkdir -p "$fonts" && mv out/*.ttf "$fonts/" && mv out/licen.txt "$fonts/" &&
    echo "[anki-ms-fonts] installed in $fonts"
