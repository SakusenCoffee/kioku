diff --git a/rslib/src/sync/http_server/kioku.rs b/rslib/src/sync/http_server/kioku.rs
new file mode 100644
index 000000000..69fefc733
--- /dev/null
+++ b/rslib/src/sync/http_server/kioku.rs
@@ -0,0 +1,123 @@
+// Added by Kioku (shared/patches/anki-syncserver.patch): the sync server on a
+// thread of its own, which an app can stop and start again in the same
+// process. The stock server stops only on Ctrl+C, and an app embedding it has
+// no terminal. Everything lives in this file so that the patch only touches
+// two lines of mod.rs.
+
+use std::cell::RefCell;
+use std::future::Future;
+use std::net::IpAddr;
+use std::net::SocketAddr;
+use std::path::PathBuf;
+
+use tokio::sync::watch;
+
+use super::default_ip_header;
+use super::SimpleServer;
+use super::SyncServerConfig;
+
+thread_local! {
+    /// Set by BackgroundServer on its thread while make_server() runs there.
+    static STOP: RefCell<Option<watch::Receiver<bool>>> = const { RefCell::new(None) };
+}
+
+/// What make_server() waits for before shutting down gracefully: Ctrl+C, as
+/// upstream, or a BackgroundServer's stop(). Takes the stop signal when
+/// called, which is on the thread that calls make_server().
+pub(super) fn shutdown_signal() -> impl Future<Output = ()> + Send + 'static {
+    let stop = STOP.with(|stop| stop.borrow_mut().take());
+    async move {
+        match stop {
+            Some(mut stop) => {
+                tokio::select! {
+                    _ = tokio::signal::ctrl_c() => {}
+                    _ = stop.wait_for(|stop| *stop) => {}
+                }
+            }
+            None => {
+                let _ = tokio::signal::ctrl_c().await;
+            }
+        }
+    }
+}
+
+/// A sync server on its own thread and runtime, which can be stopped and
+/// started again in the same process. Users come from SYNC_USER* as usual.
+pub struct BackgroundServer {
+    pub addr: SocketAddr,
+    stop: watch::Sender<bool>,
+    done: std::sync::mpsc::Receiver<()>,
+}
+
+impl BackgroundServer {
+    /// Errors are returned as text with their causes.
+    pub fn start(host: IpAddr, port: u16, base_folder: PathBuf) -> Result<Self, String> {
+        let config = SyncServerConfig {
+            host,
+            port,
+            base_folder,
+            ip_header: default_ip_header(),
+        };
+        let (stop, stopped) = watch::channel(false);
+        let (ready_tx, ready_rx) = std::sync::mpsc::channel();
+        let (done_tx, done) = std::sync::mpsc::channel();
+        std::thread::Builder::new()
+            .name("syncserver".into())
+            .spawn(move || {
+                let runtime = match tokio::runtime::Builder::new_multi_thread()
+                    .worker_threads(2)
+                    .enable_all()
+                    .build()
+                {
+                    Ok(runtime) => runtime,
+                    Err(err) => {
+                        let _ = ready_tx.send(Err(err.to_string()));
+                        return;
+                    }
+                };
+                runtime.block_on(async move {
+                    STOP.with(|stop| *stop.borrow_mut() = Some(stopped.clone()));
+                    let made = SimpleServer::make_server(config).await;
+                    STOP.with(|stop| stop.borrow_mut().take());
+                    let (addr, server) = match made {
+                        Ok(server) => server,
+                        Err(err) => {
+                            let _ = ready_tx.send(Err(snafu::Report::from_error(err).to_string()));
+                            return;
+                        }
+                    };
+                    let _ = ready_tx.send(Ok(addr));
+                    // a graceful shutdown waits for open requests; give a
+                    // stalled client a few seconds, not forever
+                    let mut deadline = stopped;
+                    tokio::select! {
+                        result = server => {
+                            if let Err(err) = result {
+                                tracing::error!(%err, "sync server stopped");
+                            }
+                        }
+                        _ = async {
+                            let _ = deadline.wait_for(|stop| *stop).await;
+                            tokio::time::sleep(std::time::Duration::from_secs(5)).await;
+                        } => {}
+                    }
+                });
+                // dropping the runtime here also drops the server state, which
+                // closes the users' collections
+                drop(runtime);
+                let _ = done_tx.send(());
+            })
+            .map_err(|err| format!("starting the sync server thread: {err}"))?;
+        match ready_rx.recv() {
+            Ok(Ok(addr)) => Ok(BackgroundServer { addr, stop, done }),
+            Ok(Err(err)) => Err(err),
+            Err(_) => Err("the sync server thread ended".into()),
+        }
+    }
+
+    /// Stops the server and waits until its collections are closed.
+    pub fn stop(self) {
+        let _ = self.stop.send(true);
+        let _ = self.done.recv_timeout(std::time::Duration::from_secs(30));
+    }
+}
