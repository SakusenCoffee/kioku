+/// A sync server on its own thread and runtime, which can be stopped and
+/// started again in the same process. Users come from SYNC_USER* as usual.
+pub struct BackgroundServer {
+    pub addr: SocketAddr,
+    stop: tokio::sync::watch::Sender<bool>,
+    done: std::sync::mpsc::Receiver<()>,
+}
+
+impl BackgroundServer {
+    /// Errors are returned as text with their causes.
+    pub fn start(host: IpAddr, port: u16, base_folder: PathBuf) -> Result<Self, String> {
+        let config = SyncServerConfig {
+            host,
+            port,
+            base_folder,
+            ip_header: default_ip_header(),
+        };
+        let (stop, stopped) = tokio::sync::watch::channel(false);
+        let (ready_tx, ready_rx) = std::sync::mpsc::channel();
+        let (done_tx, done) = std::sync::mpsc::channel();
+        std::thread::Builder::new()
+            .name("syncserver".into())
+            .spawn(move || {
+                let runtime = match tokio::runtime::Builder::new_multi_thread()
+                    .worker_threads(2)
+                    .enable_all()
+                    .build()
+                {
+                    Ok(runtime) => runtime,
+                    Err(err) => {
+                        let _ = ready_tx.send(Err(err.to_string()));
+                        return;
+                    }
+                };
+                runtime.block_on(async move {
+                    let mut graceful = stopped.clone();
+                    let shutdown = async move {
+                        let _ = graceful.wait_for(|stop| *stop).await;
+                    };
+                    let (addr, server) = match SimpleServer::make_server_until(config, shutdown).await
+                    {
+                        Ok(server) => server,
+                        Err(err) => {
+                            let _ = ready_tx.send(Err(snafu::Report::from_error(err).to_string()));
+                            return;
+                        }
+                    };
+                    let _ = ready_tx.send(Ok(addr));
+                    // a graceful shutdown waits for open requests; give a
+                    // stalled client a few seconds, not forever
+                    let mut deadline = stopped;
+                    tokio::select! {
+                        result = server => {
+                            if let Err(err) = result {
+                                tracing::error!(%err, "sync server stopped");
+                            }
+                        }
+                        _ = async {
+                            let _ = deadline.wait_for(|stop| *stop).await;
+                            tokio::time::sleep(std::time::Duration::from_secs(5)).await;
+                        } => {}
+                    }
+                });
+                // dropping the runtime here also drops the server state, which
+                // closes the users' collections
+                drop(runtime);
+                let _ = done_tx.send(());
+            })
+            .map_err(|err| format!("starting the sync server thread: {err}"))?;
+        match ready_rx.recv() {
+            Ok(Ok(addr)) => Ok(BackgroundServer { addr, stop, done }),
+            Ok(Err(err)) => Err(err),
+            Err(_) => Err("the sync server thread ended".into()),
+        }
+    }
+
+    /// Stops the server and waits until its collections are closed.
+    pub fn stop(self) {
+        let _ = self.stop.send(true);
+        let _ = self.done.recv_timeout(std::time::Duration::from_secs(30));
+    }
+}
+
 pub type ServerFuture = Pin<Box<dyn Future<Output = error::Result<(), std::io::Error>> + Send>>;
