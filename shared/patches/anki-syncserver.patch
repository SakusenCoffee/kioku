diff --git a/pylib/rsbridge/kioku.rs b/pylib/rsbridge/kioku.rs
new file mode 100644
index 000000000..7399db0cb
--- /dev/null
+++ b/pylib/rsbridge/kioku.rs
@@ -0,0 +1,47 @@
+// Added by Kioku (shared/patches/anki-syncserver.patch): start and stop the
+// sync server on a background thread of the app, see
+// rslib/src/sync/http_server/kioku.rs. In a file of its own so that the patch
+// only touches two lines of lib.rs.
+
+use anki::sync::http_server::kioku::BackgroundServer;
+use pyo3::exceptions::PyException;
+use pyo3::prelude::*;
+use pyo3::wrap_pyfunction;
+
+static SYNC_SERVER: std::sync::Mutex<Option<BackgroundServer>> = std::sync::Mutex::new(None);
+
+/// Starts the sync server on a background thread (stopping a running one
+/// first); returns the port it listens on.
+#[pyfunction]
+fn syncserver_start(py: Python<'_>, host: &str, port: u16, base: &str) -> PyResult<u16> {
+    let host: std::net::IpAddr = host
+        .parse()
+        .map_err(|e: std::net::AddrParseError| PyException::new_err(e.to_string()))?;
+    let base = std::path::PathBuf::from(base);
+    py.detach(|| {
+        let mut current = SYNC_SERVER.lock().unwrap();
+        if let Some(server) = current.take() {
+            server.stop();
+        }
+        let server = BackgroundServer::start(host, port, base).map_err(PyException::new_err)?;
+        let port = server.addr.port();
+        *current = Some(server);
+        Ok(port)
+    })
+}
+
+/// Stops the server started by syncserver_start(), if it runs.
+#[pyfunction]
+fn syncserver_stop(py: Python<'_>) {
+    py.detach(|| {
+        if let Some(server) = SYNC_SERVER.lock().unwrap().take() {
+            server.stop();
+        }
+    })
+}
+
+pub(crate) fn register(m: &Bound<'_, PyModule>) -> PyResult<()> {
+    m.add_wrapped(wrap_pyfunction!(syncserver_start))?;
+    m.add_wrapped(wrap_pyfunction!(syncserver_stop))?;
+    Ok(())
+}
