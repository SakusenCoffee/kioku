# Versions shared by the iOS and native Android builds (sourced by their
# tools/*.sh). Anki's Python packages, its Rust core and the build hash they
# check against each other must come from the same release. The Termux
# variant uses ANKI_TAG too, for the anki release of krmanik/termux-packages
# (termux/tools/fetch_anki_debs.py).
ANKI_TAG=26.09.3
ANKI_PY_VERSION=26.9.3
QT_VERSION=6.9.3
PYQT6_VERSION=6.9.1
PYQT6_SIP_VERSION=13.13.0
SIP_VERSION=6.17.1
PYQT_BUILDER_VERSION=1.20.1
PYTHON_VERSION=3.14
# BeeWare's Python.xcframework for iOS (a release tag of
# beeware/Python-Apple-support)
PYTHON_APPLE_SUPPORT_TAG=3.14-b12
ORJSON_VERSION=3.12.0
RPDS_VERSION=2026.9.1
MARKUPSAFE_VERSION=3.0.4
# aqtinstall's default mirror sometimes stalls
QT_MIRROR=https://mirrors.ocf.berkeley.edu/qt/
