<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Remote desktop: asks to leave Kioku out of battery optimisation (Settings › Remote desktop) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Phone storage in ~/storage, asked for only when the user turns it on
         (Settings → Phone storage, like termux-setup-storage). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Termux:X11 extras this app does not use. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:node="remove" />

    <!-- AnkiDroid's version and launching it (Preferences › Advanced in Anki,
         kioku/ankidroid.py PACKAGES) -->
    <queries>
        <package android:name="com.ichi2.anki" />
        <package android:name="com.ichi2.anki.debug" />
        <package android:name="com.ichi2.anki.A" />
        <package android:name="com.ichi2.anki.B" />
        <package android:name="com.ichi2.anki.C" />
        <package android:name="com.ichi2.anki.D" />
        <package android:name="com.ichi2.anki.E" />
    </queries>

    <application
        android:name=".AnkiApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:requestLegacyExternalStorage="true"
        tools:replace="android:name,android:allowBackup">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The X11 display. Started by LauncherActivity, not from the home screen. -->
        <activity
            android:name="com.termux.x11.MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            tools:replace="android:label,android:icon,android:roundIcon">
            <intent-filter tools:node="removeAll" />
            <meta-data android:name="android.app.shortcuts" tools:node="remove" />
        </activity>

        <service
            android:name="com.termux.x11.utils.KeyInterceptor"
            tools:node="remove" />

        <!-- Copies a wallpaper or a deck from the phone into the desktop; no UI
             of its own. Also offered for opening/sharing Anki decks from other apps. -->
        <activity
            android:name=".PickFileActivity"
            android:exported="true"
            android:label="@string/import_into_anki"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/apkg" />
                <data android:mimeType="application/x-apkg" />
                <data android:mimeType="application/colpkg" />
                <data android:mimeType="application/x-colpkg" />
                <data android:mimeType="application/vnd.anki" />
                <!-- What most file managers and browsers report for .apkg/.colpkg. -->
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>

        <!-- Phone storage access (ankidesk:storage); no UI of its own. -->
        <activity
            android:name=".StorageActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".AnkiService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Supervises the bundled Anki desktop runtime (X server and Python process) while the user studies, restarting it after a crash." />
        </service>

        <provider
            android:name=".HomeDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
