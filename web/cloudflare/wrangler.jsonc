// Kioku on Cloudflare Workers (free plan): build/dist (tools/dist.sh) as
// static assets, worker.js for the compressed wasm and the socket relay.
{
  "name": "kioku",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../build/dist",
    "binding": "ASSETS",
    // every request: worker.js sets the isolation headers by browser
    "run_worker_first": true
  },
  "vars": {
    // hosts:ports the relay connects to (fnmatch-style * as in
    // tools/serve.py); add-ons' services need theirs added, for example
    // "*.amboss.com:443"
    "RELAY_ALLOW": "ankiweb.net:443,*.ankiweb.net:443"
  }
}
