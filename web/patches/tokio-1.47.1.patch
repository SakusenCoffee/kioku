@@ -63,12 +66,26 @@ impl Driver {
         // safe as each dup is registered with separate reactors **and** we
         // only expect at least one dup to receive the notification.
 
+        // Emscripten has no socketpair() and a browser tab gets no signals:
+        // poll the read end of a pipe that is never written instead.
+        #[cfg(target_os = "emscripten")]
+        let mut receiver = {
+            let mut fds = [0 as libc::c_int; 2];
